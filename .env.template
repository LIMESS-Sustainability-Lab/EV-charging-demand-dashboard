# Postgres connection. Required only by the dev/exploration pages.
# Leave empty if you only run the latent-curve-model pages.
POSTGRES_CONNECTION_STRING=postgresql://user:pass@host:5432/dbname

# Toggle the dev/exploration pages (default: false).
ENABLE_DEV_PAGES=false

# Optional. "production" disables Dash debug mode in the makefile target.
ENVIRONMENT=development
